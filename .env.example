# Public URL of the app (used in emails, Stripe redirects)
APP_URL=http://localhost:3000
APP_NAME=Plinth

# SQLite file and uploads folder
DATABASE_PATH=./data/plinth.db
STORAGE_DIR=./storage

# Payments. Leave STRIPE_SECRET_KEY empty in development to use demo checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Only set to true if you deliberately want fake payments in production (e.g. a sales demo server)
ALLOW_DEMO_PAYMENTS=false

# Email: "console" (logs emails) or "resend"
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Plinth <hello@example.com>"

# Protects /api/cron/* endpoints (send as Authorization: Bearer <secret>)
CRON_SECRET=change-me
# Run the email queue inside the web process every minute
RUN_INLINE_WORKER=true
# Random string used to anonymise visitor analytics
ANALYTICS_SALT=change-me-too
